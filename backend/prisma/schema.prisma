generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model PatientRecord {
  id        String   @id @default(uuid())
  patientId String   @unique
  name      String
  age       Int
  gender    String
  village   String
  lastVisit String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
